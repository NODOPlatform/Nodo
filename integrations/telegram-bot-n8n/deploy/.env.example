# Copia a .env y rellena. NO subir .env a git.
POSTGRES_USER=n8n
POSTGRES_PASSWORD=CAMBIA_ESTO_clave_fuerte
POSTGRES_DB=n8n

# Genera una clave de 32+ chars (debe ser la MISMA en main/worker/webhook):
#   openssl rand -hex 24
N8N_ENCRYPTION_KEY=CAMBIA_ESTO_32_chars_minimo

# URL publica HTTPS donde Telegram entrega los updates (tu dominio / easypanel)
WEBHOOK_URL=https://tu-subdominio.tu-dominio.com/

# Tuning de escala
N8N_WORKER_CONCURRENCY=8
N8N_CONCURRENCY_PRODUCTION_LIMIT=100
